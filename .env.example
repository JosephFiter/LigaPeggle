# Copiá este archivo a .env.local para desarrollo, y cargá las mismas variables
# en Vercel (Project > Settings > Environment Variables).

# Contraseña para entrar como admin en la página.
ADMIN_PASSWORD=

# jsonbin.io: ID del bin donde vive la liga y la X-Master-Key de tu cuenta.
# Si no están (solo en local), la liga se guarda en .data/league.json.
JSONBIN_BIN_ID=
JSONBIN_MASTER_KEY=
